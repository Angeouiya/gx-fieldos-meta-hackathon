# Copier les variables serveur dans apps/web/.env.local (fichier ignoré par Git).
# Ne jamais placer une clé de modèle dans une variable NEXT_PUBLIC_ ou VITE_.
GX_MODEL_PROVIDER=meta
MODEL_API_KEY=
GX_META_MODEL=muse-spark-1.3
# Mode OpenAI historique disponible seulement avec GX_MODEL_PROVIDER=openai.
OPENAI_API_KEY=
GX_CHAT_ACCESS_TOKEN=
GX_OPENAI_MODEL=gpt-6-astra
# Production Agrix: configure these values on the GX server. The same
# GX_SERVICE_SECRET (32+ random characters) must exist on the Agrix server.
# GX_AGRIX_SESSION_MODE=true
# GX_AGRIX_ACCESS_URL=https://agrix.africa/api/gx/access
# GX_SERVICE_SECRET=
# Local-only FieldOS proxy: run AGRIX on this same loopback hostname and a different port.
# GX_AGRIX_DEV_ORIGIN=http://127.0.0.1:3001
# GX_CHAT_REQUESTS_PER_MINUTE=10
# GX_CHAT_MAX_OUTPUT_TOKENS=4096
# GX_CHAT_ALLOWED_ORIGINS=http://127.0.0.1:1420,http://tauri.localhost,tauri://localhost
# Local FieldOS demo only (never enabled in production builds):
# GX_FIELD_DEMO_MODE=true
# GX_FIELD_DEMO_REPLAY=true
